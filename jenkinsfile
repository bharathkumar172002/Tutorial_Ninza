pipeline {
    agent any
 
    tools {
        maven 'maven 3'
        jdk 'jdk21'
    }
 
    stages {
 
        stage('Checkout') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/bharathkumar172002/wipro_Trainning_Project.git'
            }
        }
 
 
 
        stage('Build') {
            steps {
                dir('Tutorial_Ninza') {
                    bat 'mvn clean'
                }
            }
        }
 
        stage('Compile') {
            steps {
                dir('Tutorial_Ninza') {
                    bat 'mvn compile'
                }
            }
        }
 
        stage('Test') {
            steps {
                dir('Tutorial_Ninza') {
                    bat 'mvn test'
                }
            }
        }
 
        stage('Package') {
            steps {
                dir('Tutorial_Ninza') {
                    bat 'mvn package'
                }
            }
        }
    }
 
    post {
        success {
            echo 'Build Successful'
        }
 
        failure {
            echo 'Build Failed'
        }
    }
}